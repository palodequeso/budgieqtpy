{
    "id": "org.palodequeso.budgie",
    "runtime": "org.palodequeso.Platform",
    "runtime-version": "6.8",
    "sdk": "org.palodequeso.Sdk",
    "base": "com.riverbankcomputing.PyQt.BaseApp",
    "base-version": "6.8",
    "command": "budgie",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--socket=pulseaudio",
        "--filesystem=xdg-documents",
        "--share=network"
    ],
    "build-options": {
        "build-args": [
            "--share=network"
        ]
    },
    "modules": [
        {
            "name": "python-dependencies",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --prefix=/app --no-cache-dir odswriter==0.4.0"
            ],
            "sources": []
        },
        {
            "name": "budgie",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --prefix=/app --no-build-isolation .",
                "install -Dm644 org.palodequeso.budgie.desktop /app/share/applications/org.palodequeso.budgie.desktop",
                "install -Dm644 org.palodequeso.budgie.svg /app/share/icons/hicolor/scalable/apps/org.palodequeso.budgie.svg"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "."
                }
            ]
        }
    ]
}
